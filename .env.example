APP_NAME="Job Application"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=123456
REVERB_APP_KEY=your-reverb-key
REVERB_APP_SECRET=your-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default: log mailer — verification emails are written to storage/logs/laravel.log
# instead of being sent (safe for local development).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# To actually receive mail, switch to SMTP. Two good options:
#
# 1. Mailtrap (email testing sandbox) — mail is captured in your Mailtrap
#    web inbox and never reaches the real recipient. Get the credentials
#    from mailtrap.io → Email Testing → Inboxes → <your inbox> → SMTP Settings.
#    MAIL_MAILER=smtp
#    MAIL_SCHEME=null
#    MAIL_HOST=sandbox.smtp.mailtrap.io
#    MAIL_PORT=2525
#    MAIL_USERNAME=<your mailtrap smtp username>
#    MAIL_PASSWORD=<your mailtrap smtp password>
#    MAIL_FROM_ADDRESS="hello@example.com"
#    MAIL_FROM_NAME="${APP_NAME}"
#
# 2. Any real SMTP server (production) — keep values in .env only, never commit
#    real credentials. Example:
#    MAIL_MAILER=smtp
#    MAIL_SCHEME=null
#    MAIL_HOST=smtp.example.com
#    MAIL_PORT=587
#    MAIL_USERNAME=<smtp username>
#    MAIL_PASSWORD=<smtp password>
#    MAIL_FROM_ADDRESS="hello@example.com"
#    MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
